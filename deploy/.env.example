# Optional root directory for deploy helper scripts that copy local-dev keys (see deploy/README.md).
ELD_ROOT=../path-to-local-keys
TENDERMINT_DIR=../third_party/tendermint

# Required image version tags (OS + version, e.g. macos-0.0.16). Scripts refuse to run if unset.
TENDERMINT_VERSION_TAG=macos-0.0.16
NODE_APP_VERSION_TAG=macos-0.0.41
