# Sibling eld checkout (Tendermint source, local-dev secrets). Relative to eld-chain root.
ELD_ROOT=../eld
TENDERMINT_DIR=../eld/third_party/tendermint

# Required image version tags (OS + version, e.g. macos-0.0.16). Scripts refuse to run if unset.
TENDERMINT_VERSION_TAG=macos-0.0.16
NODE_APP_VERSION_TAG=macos-0.0.41
