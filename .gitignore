/target
**/*.rs.bk

node_app/data/
node_app/tx_responses/

.idea/
.vscode/
.DS_Store
.env
.env.*
!.env.example
!deploy/.env.example
*.pem
*.key
wallets/
**/wallets.json
config/*.json
!config/*.json.example
_dev-docs/
.cursor/

# Local host binary runtime (cwd is deploy/host/single)
deploy/host/single/data/
deploy/host/single/tendermint.log
deploy/host/single/config/p2p_keypair.json

# Local cluster compose secrets (copied from sibling eld; not committed)
deploy/docker/local/cluster/nodes/*/app/p2p_keypair.json
deploy/docker/local/cluster/nodes/*/tendermint/node_key.json
deploy/docker/local/cluster/nodes/*/tendermint/priv_validator_key.json
deploy/docker/local/cluster/nodes/*/tendermint/addrbook.json

# Local single-node Tendermint keys (copies; not committed)
deploy/docker/local/single/tendermint/addrbook.json
deploy/docker/local/single/tendermint/node_key.json
deploy/docker/local/single/tendermint/priv_validator_key.json